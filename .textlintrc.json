{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "skipPatterns": [
          "/\\$\\$[\\s\\S]*?\\$\\$/m"
        ]
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [":::"]
      },
      "no-exclamation-question-mark": false
    },
    "preset-ja-spacing": {
      "ja-space-between-half-and-full-width": {
        "space": "always"
      }
    }
  }
}
